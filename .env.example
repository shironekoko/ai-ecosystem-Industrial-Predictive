# คัดลอกเป็น .env (compose.yml โหลดให้ backend + trainer-worker) — ค่าใน compose.yml (DATABASE_URL, MINIO_ENDPOINT, REDIS_URL) ทับค่าที่นี่
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydatabase
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
# ตั้งค่าคงที่ไว้ → ล็อกอินค้างได้แม้ restart backend (ไม่ตั้ง = สุ่มใหม่ทุกครั้งที่ backend เริ่ม)
JWT_SECRET_KEY=super-secret-key-change-in-production-please
