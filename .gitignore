# Environments (ค่าลับอยู่ใน .env — ดูตัวอย่างที่ .env.example)
.env
.venv
backend/.venv

# Node / Frontend
node_modules/
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/

# Logs ที่ระบบเขียนตอนรัน (compose mount ./logs และ backend/logs)
logs/*
!logs/.gitkeep
backend/logs/*
!backend/logs/.gitkeep

# ชุดข้อมูล (ไฟล์ใหญ่) — ดูวิธีวางที่ dataset/README.md
dataset/*
!dataset/README.md
*.mat
*.h5

# น้ำหนักแบบจำลอง (เก็บใน MinIO; อัปโหลดด้วย backend/scripts/publish_*.py)
*.pt
*.pth
*.onnx

# TensorBoard runs และน้ำหนัก ImageNet ที่ torchvision ดาวน์โหลดระหว่างการทดลอง
runs/
nontime_docs/tool_vb_vision/.torch_cache/

# Archives
*.zip
*.tar.gz
*.7z

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
